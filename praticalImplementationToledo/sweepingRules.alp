			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1772014312378</Id>
					<Name><![CDATA[fnCalcDistanceToWall]]></Name>
					<X>250</X><Y>800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[MyBotDummy]]></Type>
					</Parameter>
					<Body><![CDATA[Position pos = agent.getPosition();
Point pWall = new Point();
wall.getNearestPoint(pos.getX(), pos.getY(), pWall);

// Update text
double distance = agent.distanceTo(pWall.getX(), pWall.getY(), LENGTH_UNIT_METER);
String str = String.format(Locale.US, "%.1f", distance);
agent.txtDistance.setText(str);

return distance;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Point]]></ReturnType>
					<Id>1772014687724</Id>
					<Name><![CDATA[fnTakeStepAhead]]></Name>
					<X>250</X><Y>825</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[MyBotDummy]]></Type>
					</Parameter>
					<Body><![CDATA[// Get current position.
Position currentPos = agent.getPosition();
double theta = currentPos.rotation;
double x = currentPos.x;
double y = currentPos.y;

// Calculate step ahead.
double step = scale.toPixels(parStepSizeInMeter, LENGTH_UNIT_METER);
double newX = x + step*Math.cos(theta);
double newY = y + step*Math.sin(theta);

// Adjust location.
return new Point(newX, newY);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Point]]></ReturnType>
					<Id>1772018349824</Id>
					<Name><![CDATA[fnTakeStepRightAlongArc]]></Name>
					<X>250</X><Y>850</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[MyBotDummy]]></Type>
					</Parameter>
					<Body><![CDATA[// Parameters you (can potentially) control
double step = scale.toPixels(parStepSizeInMeter, LENGTH_UNIT_METER);
double R = scale.toPixels(parTurnRadiusInMeter, LENGTH_UNIT_METER);
double turnAngle = step/R;

// Get current position
Position pos = agent.getPosition();
double x = pos.getX();
double y = pos.getY();
double theta = agent.varThetaRadians;

// Get the circle centroid
double xc = x - R*Math.sin(theta);
double yc = y + R*Math.cos(theta);

// Calculate the new position
double delta = theta+turnAngle;

double newX = xc + R*Math.sin(delta);
double newY = yc - R*Math.cos(delta);

// Update the agent's angle (not for visualisation, but internal consistency).
agent.varThetaRadians = delta;
String strDelta = String.format(Locale.US, "%.1f", fnNormaliseRadToDegree(delta));
agent.txtAngle.setText(strDelta);

return new Point(newX, newY);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1773224718794</Id>
					<Name><![CDATA[fnNormaliseRadToDegree]]></Name>
					<X>250</X><Y>875</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[headingRad]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[
// Map your math heading (radians, CW+) to a stable display angle (degrees)
double visualDeg = Math.toDegrees(headingRad);

// Normalize to [0, 360)
visualDeg = ((visualDeg % 360) + 360) % 360;

return visualDeg;]]></Body>
				</Function>
			</Functions>
