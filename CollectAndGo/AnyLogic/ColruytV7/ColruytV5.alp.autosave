				<StatechartElement Class="Transition" ParentState="ROOT_NODE">
					<Id>1777894503455</Id>
					<Name><![CDATA[transition]]></Name>
					<X>360</X><Y>240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<Points>
						<Point><X>0</X><Y>0</Y></Point>
						<Point><X>0</X><Y>60</Y></Point>
					</Points>
					<IconOffset>20.0</IconOffset>
					<Properties Source="1777894091143" Target="1776689338483" Trigger="condition">
						<Action><![CDATA[timeArrivedAtPickup = time();
traceln("Robot" + robotId + " arrived at store node" + (currentPickupIdx+1)
    + " — picking up order -> dest=node" + (currentDestIdx+1));

// Remove from global order list
for (int i = main.orderList.size() - 1; i >= 0; i--) {
    int[] t = main.orderList.get(i);
    if (t[0] == currentPickupIdx && t[1] == currentDestIdx) {
        main.orderList.remove(i);
        break;
    }
}

// Calculate delivery route ONCE here
NodeLoc pickup = main.globalNodes.get(currentPickupIdx);
NodeLoc destination = main.globalNodes.get(currentDestIdx);
plannedRoute = calculatePath(pickup, destination, parDeliveryMode);
routeHopsToDestination = (plannedRoute != null) ? plannedRoute.size() : 0;

int phaseIdxA = (main.comparisonPhase >= 0) ? main.comparisonPhase : 0;
main.writeEventLog(phaseIdxA, main.effectiveRoutingMode, time(), robotId, "ARRIVED_AT_PICKUP",
    "node" + (currentPickupIdx+1), "node" + (currentDestIdx+1), myOrderId,
    "toPickupTime=" + String.format("%.1f", timeArrivedAtPickup - timeOrderStart) + "s");

java.awt.Color[] rColors = {
    java.awt.Color.BLUE, java.awt.Color.MAGENTA,
    new java.awt.Color(0,180,0), java.awt.Color.CYAN
};
drawRoute(plannedRoute, pickup,
    (robotId < rColors.length) ? rColors[robotId] : java.awt.Color.WHITE);
deliveryComplete = false;
traceln("Robot" + robotId + " delivery route calculated | size=" + plannedRoute.size());]]></Action>
