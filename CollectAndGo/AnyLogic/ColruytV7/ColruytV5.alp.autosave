			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[NodeLoc]]></ReturnType>
					<Id>1775702135279</Id>
					<Name><![CDATA[findClosestNode]]></Name>
					<X>50</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[x]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[y]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[NodeLoc closest = null;
double best = Double.MAX_VALUE;
for (NodeLoc n : main.globalNodes) {
    double d = Math.sqrt(Math.pow(n.x - x, 2) + Math.pow(n.y - y, 2));
    if (d < best) { best = d; closest = n; }
}
return closest;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.util.List<NodeLoc>]]></ReturnType>
					<Id>1775784647639</Id>
					<Name><![CDATA[calculatePath]]></Name>
					<X>50</X><Y>330</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[start]]></Name>
						<Type><![CDATA[NodeLoc]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[end]]></Name>
						<Type><![CDATA[NodeLoc]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[mode]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.List<NodeLoc> path = new java.util.ArrayList<>();
if (start == null || end == null) return path;

NodeLoc sNode = findClosestNode(start.x, start.y);
NodeLoc eNode = findClosestNode(end.x, end.y);

if (sNode == null || eNode == null) return path;

java.util.Map<NodeLoc, Double> dist = new java.util.HashMap<>();
java.util.Map<NodeLoc, NodeLoc> prev = new java.util.HashMap<>();
java.util.List<NodeLoc> unvisited = new java.util.ArrayList<>(main.globalNodes);

for (NodeLoc n : unvisited) {
    dist.put(n, Double.MAX_VALUE);
    prev.put(n, null);
}
dist.put(sNode, 0.0);

while (!unvisited.isEmpty()) {
    NodeLoc u = null;
    double md = Double.MAX_VALUE;
    for (NodeLoc n : unvisited) {
        if (dist.get(n) < md) {
            md = dist.get(n);
            u = n;
        }
    }
    
    if (u == null || dist.get(u) == Double.MAX_VALUE) break;
    if (u == eNode) break;
    unvisited.remove(u);
    
    for (NodeLoc.Edge e : u.edges) {
        NodeLoc v = e.target;
        if (!unvisited.contains(v)) continue;
        
        double cost = Math.sqrt(Math.pow(v.x - u.x, 2) + Math.pow(v.y - u.y, 2));
        if (mode == 1) cost *= (1.0 + (v.crowdedness * 0.5));
        
        double alt = dist.get(u) + cost;
        if (alt < dist.get(v)) {
            dist.put(v, alt);
            prev.put(v, u);
        }
    }
}

NodeLoc curr = eNode;
while (curr != null && curr != sNode) {
    path.add(0, curr);
    curr = prev.get(curr);
}

if (curr == null) {
    path.clear();
    path.add(end);
}

return path;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1775820392460</Id>
					<Name><![CDATA[drawRoute]]></Name>
					<X>50</X><Y>360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[path]]></Name>
						<Type><![CDATA[java.util.List<NodeLoc>]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[source]]></Name>
						<Type><![CDATA[NodeLoc]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[color]]></Name>
						<Type><![CDATA[java.awt.Paint]]></Type>
					</Parameter>
					<Body><![CDATA[clearRoute();
if (path == null || path.isEmpty() || source == null) return;
NodeLoc last = source;
for (NodeLoc n : path) {
    com.anylogic.engine.presentation.ShapeLine line = new com.anylogic.engine.presentation.ShapeLine();
    line.setX(last.x); line.setY(last.y);
    line.setDx(n.x - last.x); line.setDy(n.y - last.y);
    line.setLineWidth(3.0);
    line.setColor(color);
    routeLines.add(line);
    main.presentation.add(line);
    last = n;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1775526466007</Id>
					<Name><![CDATA[clearRoute]]></Name>
					<X>50</X><Y>390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for (com.anylogic.engine.presentation.ShapeLine line : routeLines) {
    main.presentation.remove(line);
}
routeLines.clear();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1779917165419</Id>
					<Name><![CDATA[calculateExpectedTime]]></Name>
					<X>50</X><Y>420</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[s]]></Name>
						<Type><![CDATA[NodeLoc]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[e]]></Name>
						<Type><![CDATA[NodeLoc]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[mode]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.List<NodeLoc> p = calculatePath(s, e, mode);
if (p.isEmpty()) return 0.0;
double d = 0;
NodeLoc last = findClosestNode(s.x, s.y);
for (NodeLoc n : p) {
    d += Math.sqrt(Math.pow(n.x - last.x, 2) + Math.pow(n.y - last.y, 2));
    last = n;
}
return d / 10.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777891371555</Id>
					<Name><![CDATA[buildLocalOrderList]]></Name>
					<X>300</X><Y>540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[


localOrderList.clear();

// Copy the global order registry
java.util.List<int[]> all = new java.util.ArrayList<>(main.orderList);

// Sort by distance from this robot's current position to each pickup node
all.sort((a, b) -> {
    NodeLoc pa = main.globalNodes.get(a[0]);
    NodeLoc pb = main.globalNodes.get(b[0]);
    // AFTER — true shortest path cost via Dijkstra
    NodeLoc robPos = findClosestNode(getX(), getY());
    double da = calculateExpectedTime(robPos, pa, 0);
    double db = calculateExpectedTime(robPos, pb, 0);
    return Double.compare(da, db);
});

localOrderList.addAll(all);

traceln("Robot" + robotId + " built local order list ("
    + localOrderList.size() + " tasks) from position ("
    + (int)getX() + "," + (int)getY() + "):");
for (int i = 0; i < localOrderList.size(); i++) {
    int[] t = localOrderList.get(i);
    traceln("  [" + i + "] pickup=node" + (t[0]+1) + " -> dest=node" + (t[1]+1));
}

]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777891892713</Id>
					<Name><![CDATA[selectNextTask]]></Name>
					<X>300</X><Y>440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Guard: robot already has active task — do not claim another
if (parStartNode != null) {
    traceln("Robot" + robotId + " selectNextTask: already has task, skipping");
    return;
}

traceln("Robot" + robotId + " selectNextTask() called | localOrderList.size="
    + localOrderList.size() + " | simTime=" + time());

if (localOrderList.isEmpty()) {
    parDestinationNode = null;
    traceln("Robot" + robotId + " finished all tasks. Becoming idle.");
    if (main.simulationReady && time() > 0) {
        main.checkAllDone();
    }
    return;
}

int[] selectedTask = null;

if (main.effectiveRoutingMode == 2) {
    // EA: expectation-aware scoring with lookahead and graduated conflict penalty
    double bestScore = Double.MAX_VALUE;
    NodeLoc robPos = findClosestNode(getX(), getY());

    for (int[] task : localOrderList) {
        NodeLoc pickup = main.globalNodes.get(task[0]);
        NodeLoc dest   = main.globalNodes.get(task[1]);

        // Travel to store + delivery leg
        double t = calculateExpectedTime(robPos, pickup, 1)
                 + calculateExpectedTime(pickup, dest, 1);

        // Lookahead: cost to nearest remaining order from destination
        double minNextCost = Double.MAX_VALUE;
        for (int[] next : localOrderList) {
            if (next == task) continue;
            NodeLoc nextPickup = main.globalNodes.get(next[0]);
            double nextCost = calculateExpectedTime(dest, nextPickup, 1);
            if (nextCost < minNextCost) minNextCost = nextCost;
        }
        // No next task — fall back to depot
        if (minNextCost == Double.MAX_VALUE) {
            minNextCost = calculateExpectedTime(dest, main.globalNodes.get(0), 1);
        }
        t += minNextCost;

        // Graduated conflict penalty
        double penalty = 0;
        for (int i = 0; i < main.numRobots; i++) {
            Robot other = main.getRobotByIndex(i);
            if (other == null || other == this) continue;
            if (other.parDestinationNode != null) {
                double overlap = Math.sqrt(
                    Math.pow(other.parDestinationNode.x - dest.x, 2) +
                    Math.pow(other.parDestinationNode.y - dest.y, 2));
                if (overlap < main.conflictRadiusThreshold) {
                    penalty += main.conflictPenaltyWeight
                             * (1.0 - overlap / main.conflictRadiusThreshold);
                }
            }
        }

        double score = t + penalty;
        if (score < bestScore) {
            bestScore = score;
            selectedTask = task;
        }
    }
} else {
    // SSP / EV: list already Dijkstra-sorted — take first entry
    selectedTask = localOrderList.get(0);
}

if (selectedTask == null) selectedTask = localOrderList.get(0);

// Atomic claim check
String taskKey = selectedTask[0] + "_" + selectedTask[1];
if (main.claimedOrders.contains(taskKey)) {
    traceln("Robot" + robotId + " task already claimed, skipping: node"
        + (selectedTask[0]+1) + " -> node" + (selectedTask[1]+1));
    localOrderList.remove(selectedTask);
    if (!localOrderList.isEmpty()) selectNextTask();
    return;
}
main.claimedOrders.add(taskKey);

// Claim: remove from own list
localOrderList.remove(selectedTask);

// Broadcast: notify peers
for (int i = 0; i < main.numRobots; i++) {
    Robot other = main.getRobotByIndex(i);
    if (other != null && other != this) {
        other.removeClaimedTask(selectedTask[0], selectedTask[1]);
    }
}

// Set navigation targets
parStartNode       = main.globalNodes.get(selectedTask[0]);
parDestinationNode = main.globalNodes.get(selectedTask[1]);
currentPickupIdx   = selectedTask[0];
currentDestIdx     = selectedTask[1];

// Find matching store
myPackage = null;
for (int i = 0; i < main.Store.size(); i++) {
    Package pkg = (Package) main.Store.get(i);
    if (pkg.orderIndex == selectedTask[0]) {
        myPackage = pkg;
        break;
    }
}
if (myPackage == null) {
    traceln("WARNING: Robot" + robotId + " no store found at node" + (selectedTask[0]+1));
}

main.robotOrders[robotId]++;
myOrderId = main.robotOrders[robotId];
traceln("=== Robot" + robotId + " claimed: pickup=node" + (selectedTask[0]+1)
    + " -> dest=node" + (selectedTask[1]+1)
    + " | localList remaining: " + localOrderList.size() + " ===");
int phaseIdxC = (main.comparisonPhase >= 0) ? main.comparisonPhase : 0;
main.writeEventLog(phaseIdxC, main.effectiveRoutingMode, time(), robotId, "TASK_CLAIMED",
    "node" + (selectedTask[0]+1), "node" + (selectedTask[1]+1), myOrderId,
    "mode=" + main.getModeName(main.effectiveRoutingMode)
    + " remaining=" + localOrderList.size());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777891928770</Id>
					<Name><![CDATA[removeClaimedTask]]></Name>
					<X>300</X><Y>500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[pickupIdx]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[destIdx]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[for (int i = localOrderList.size() - 1; i >= 0; i--) {
    int[] t = localOrderList.get(i);
    if (t[0] == pickupIdx && t[1] == destIdx) {
        localOrderList.remove(i);
        traceln("Robot" + robotId + " removed claimed task: pickup=node"
            + (pickupIdx+1) + " -> dest=node" + (destIdx+1));
        break;
    }
}]]></Body>
				</Function>
