		<!--   =========   Simulation Experiment   ========  -->
		<SimulationExperiment ActiveObjectClassId="1774376502077">
			<Id>1774376502088</Id>
			<Name><![CDATA[Simulation]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<InitialSetupCode><![CDATA[routingModeSlider.setValue(0);
numRobotsSlider.setValue(2);
numOrdersSlider.setValue(6);
crowdednessLevelSlider.setValue(3);]]></InitialSetupCode>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<BeforeSimulationRunCode><![CDATA[root.crowdednessLevel = (int) crowdednessLevelSlider.getValue();
root.routingMode      = (int) routingModeSlider.getValue();
root.numRobots        = (int) numRobotsSlider.getValue();
root.numOrders        = (int) numOrdersSlider.getValue();]]></BeforeSimulationRunCode>
			<SeedValue>1</SeedValue>
			<SelectionModeForSimultaneousEvents>LIFO</SelectionModeForSimultaneousEvents>
			<VmArgs><![CDATA[]]></VmArgs>
			<LoadRootFromSnapshot>false</LoadRootFromSnapshot>

			<Presentation>
				<Text>
					<Id>1774376502090</Id>
					<Name><![CDATA[text]]></Name>
					<X>50</X><Y>30</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<EmbeddedIcon>false</EmbeddedIcon>
					<Z>0</Z>
					<Rotation>0.0</Rotation>
					<Color>-12490271</Color>
					<Text><![CDATA[ColruytV2 — Multi-Robot Delivery Simulation]]></Text>
					<Font>
						<Name>SansSerif</Name>
						<Size>22</Size>
						<Style>1</Style>
					</Font>
					<Alignment>LEFT</Alignment>
				</Text>
				<Text>
					<Id>1780600000001</Id>
					<Name><![CDATA[paramSection]]></Name>
					<X>50</X><Y>75</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<EmbeddedIcon>false</EmbeddedIcon>
					<Z>0</Z>
					<Rotation>0.0</Rotation>
					<Color>-13421773</Color>
					<Text><![CDATA[PARAMETER GUIDE  —  set sliders below, then press ▶ Run]]></Text>
					<Font>
						<Name>SansSerif</Name>
						<Size>13</Size>
						<Style>1</Style>
					</Font>
					<Alignment>LEFT</Alignment>
				</Text>
				<Text>
					<Id>1780600000002</Id>
					<Name><![CDATA[routingModeGuide]]></Name>
					<X>200</X><Y>105</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<EmbeddedIcon>false</EmbeddedIcon>
					<Z>0</Z>
					<Rotation>0.0</Rotation>
					<Color>-16777216</Color>
					<Text><![CDATA[routingMode   [slider  0 – 3]

  0 = SSP  (Shortest Path)
           Greedy nearest-pickup + standard Dijkstra.
           Edge cost = distance only.  Ignores pedestrian congestion.

  1 = EV   (Environment-Aware)
           Greedy nearest-pickup + crowdedness-weighted Dijkstra.
           Edge cost = distance × (1 + crowdedness × 0.5).
           Robots prefer less-congested routes.

  2 = EA   (Environment + Agent-Aware)
           Task selection minimises expected completion time,
           with a penalty when another robot targets the same area.
           Routing uses EV (crowd-weighted Dijkstra).

  3 = COMPARE  (Fair Head-to-Head Benchmark)
           Runs all three strategies (SSP → EV → EA) sequentially
           using IDENTICAL orders, start positions, and all other
           parameters.  Results go into a single set of CSV files
           for direct comparison.  Dashboard shows live KPIs for
           each completed phase.]]></Text>
					<Font>
						<Name>Monospaced</Name>
						<Size>12</Size>
						<Style>0</Style>
					</Font>
					<Alignment>LEFT</Alignment>
				</Text>
				<Text>
					<Id>1780600000003</Id>
					<Name><![CDATA[numRobotsGuide]]></Name>
					<X>200</X><Y>410</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<EmbeddedIcon>false</EmbeddedIcon>
					<Z>0</Z>
					<Rotation>0.0</Rotation>
					<Color>-16777216</Color>
					<Text><![CDATA[numRobots     [slider  1 – 4]

  Number of active delivery robots dispatched simultaneously.
  Each robot works on an independent task from the shared queue.
  Colors on map:  Robot 0 = Blue    Robot 1 = Magenta
                  Robot 2 = Green   Robot 3 = Cyan]]></Text>
					<Font>
						<Name>Monospaced</Name>
						<Size>12</Size>
						<Style>0</Style>
					</Font>
					<Alignment>LEFT</Alignment>
				</Text>
				<Text>
					<Id>1780600000004</Id>
					<Name><![CDATA[numOrdersGuide]]></Name>
					<X>200</X><Y>510</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<EmbeddedIcon>false</EmbeddedIcon>
					<Z>0</Z>
					<Rotation>0.0</Rotation>
					<Color>-16777216</Color>
					<Text><![CDATA[numOrders     [slider  1 – 50]

  Total deliveries pre-generated before the run starts (offline planning).
  Pickup and delivery nodes are random; pickup ≠ depot, dist(pickup,dest) ≥ 50 m.
  All tasks are known in advance — robots plan routes before departure.]]></Text>
					<Font>
						<Name>Monospaced</Name>
						<Size>12</Size>
						<Style>0</Style>
					</Font>
					<Alignment>LEFT</Alignment>
				</Text>
				<Text>
					<Id>1780600000005</Id>
					<Name><![CDATA[outputGuide]]></Name>
					<X>190</X><Y>830</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<EmbeddedIcon>false</EmbeddedIcon>
					<Z>0</Z>
					<Rotation>0.0</Rotation>
					<Color>-10066330</Color>
					<Text><![CDATA[OUTPUT  (3 CSV files written per run to working directory)
  detail_RUNID.csv  — one row per completed delivery task
    runId | phase | effectiveMode | modeName | robotId | taskSeq |
    pickupNode | destNode | taskStartSim |
    toPickupSec | deliveryLegSec | returnSec | totalSec |
    expOutSec | expInSec | hopsToStore | hopsToDest | hopsReturn |
    crowdednessLevel | numRobots | numOrders | randomSeed

  events_RUNID.csv  — timestamped audit trail of every robot decision
    runId | phase | effectiveMode | modeName | simTime | robotId |
    eventType | pickupNode | destNode | taskSeq | detail
    Events: PHASE_START/END | TASK_CLAIMED | DEPART_TO_PICKUP |
            ARRIVED_AT_PICKUP | DEPART_TO_DEST | ARRIVED_AT_DEST |
            DEPART_RETURN | TASK_COMPLETE

  summary_RUNID.csv  — one row per phase (3 rows in COMPARE mode)
    runId | phase | effectiveMode | modeName |
    numRobots | numOrders | crowdednessLevel | randomSeed |
    makespan | totalDeliveries | avgTaskSec | minTaskSec | maxTaskSec |
    avgToPickupSec | avgDeliveryLegSec | avgReturnSec |
    robot0–3 Tasks & TotalSec]]></Text>
					<Font>
						<Name>Monospaced</Name>
						<Size>12</Size>
						<Style>0</Style>
					</Font>
					<Alignment>LEFT</Alignment>
				</Text>
				<Text>
					<Id>1780600000006</Id>
					<Name><![CDATA[hypothesisGuide]]></Name>
					<X>210</X><Y>1140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<EmbeddedIcon>false</EmbeddedIcon>
					<Z>0</Z>
					<Rotation>0.0</Rotation>
					<Color>-8355712</Color>
					<Text><![CDATA[HYPOTHESES
  H1: EA < EV < SSP makespan under high congestion
  H2: Under high congestion robots avoid dense zones (EV / EA)
  H3: Congestion threshold above which EV/EA gain is statistically significant
  H4: EA outperforms EV regardless of congestion (agent-awareness helps independently)]]></Text>
					<Font>
						<Name>Monospaced</Name>
						<Size>12</Size>
						<Style>0</Style>
					</Font>
					<Alignment>LEFT</Alignment>
				</Text>
				<Text>
					<Id>1777214246296</Id>
					<Name><![CDATA[crowdednessLevelGuide]]></Name>
					<X>200</X><Y>615</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<EmbeddedIcon>false</EmbeddedIcon>
					<Z>0</Z>
					<Rotation>0.0</Rotation>
					<Color>-16777216</Color>
					<Text><![CDATA[crowdednessLevel  [slider  1 - 5]
 
  Pedestrian density on the map. Constant for the whole run.
    1 = very quiet      	2 / min spawn (mapwide)
    2 = quiet           	10 / min
    3 = moderate       15 / min   (default)
    4 = busy           	20 / min
    5 = very busy      	30 / min
 
  Spatial pattern (city-centre busier than outskirts) is preserved
  via per-node crowdedness weights set in Main's startup code.
]]></Text>
					<Font>
						<Name>Monospaced</Name>
						<Size>12</Size>
						<Style>0</Style>
					</Font>
					<Alignment>LEFT</Alignment>
