				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000100002</Id>
					<Name><![CDATA[writeEventLog]]></Name>
					<X>880</X><Y>810</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[phase]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[mode]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[simT]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[robotId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[eventType]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[pickupNode]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[destNode]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[taskSeq]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[detail]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (eventLogWriter == null) return;
try {
    String rStr = (robotId < 0) ? "sys" : ("R" + robotId);
    String tStr = (taskSeq  < 0) ? "-"   : String.valueOf(taskSeq);
    eventLogWriter.printf("%s,%d,%d,%s,%.3f,%s,%s,%s,%s,%s,\"%s\"%n",
        currentRunId, phase, mode, getModeName(mode),
        simT, rStr, eventType, pickupNode, destNode, tStr,
        detail.replace("\"", "'"));
    eventLogWriter.flush();
} catch (Exception e) { traceln("Event log error: " + e.getMessage()); }]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000100003</Id>
					<Name><![CDATA[resetForNextPhase]]></Name>
					<X>880</X><Y>840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[comparisonPhase++;
effectiveRoutingMode = comparisonPhase;
traceln("=== COMPARE: Starting Phase " + comparisonPhase
    + " (" + getModeName(effectiveRoutingMode) + ") at simTime=" + time() + " ===");

// Reset per-phase accumulators
totalDeliveries   = 0;
phaseDeliveryCount = 0;
phaseTaskTimeSum  = 0; phaseOutTimeSum = 0; phaseInTimeSum = 0; phaseReturnTimeSum = 0;
phaseMinTaskTime  = Double.MAX_VALUE; phaseMaxTaskTime = 0;
for (int i = 0; i < 4; i++) { phaseRobotTaskCount[i] = 0; phaseRobotTotalTime[i] = 0; robotOrders[i] = 0; }
phaseStartSimTime = time();

// Restore orders
orderList.clear();
claimedOrders.clear();
for (int[] t : savedOrderList) orderList.add(new int[]{t[0], t[1], t[2]});
traceln("COMPARE: Restored " + orderList.size() + " orders");

// Log phase-start event
writeEventLog(comparisonPhase, effectiveRoutingMode, time(), -1, "PHASE_START",
    "-", "-", -1, "Phase " + comparisonPhase + " mode=" + getModeName(effectiveRoutingMode));

// Reset robots to their fixed start positions
int[] startNodes = {0, 10, 40, 60};
for (int i = 0; i < numRobots; i++) {
    Robot rob = getRobotByIndex(i);
    if (rob == null) continue;
    int nodeIdx = startNodes[Math.min(i, startNodes.length - 1)];
    NodeLoc startLoc = globalNodes.get(nodeIdx);
    rob.setXY(startLoc.x, startLoc.y);
    rob.parStartNode       = null;
    rob.parDestinationNode = null;
    rob.currentPickupIdx   = -1;
    rob.currentDestIdx     = -1;
    rob.ordersCompleted    = 0;
    rob.deliveryComplete   = false;
    rob.returnComplete     = false;
    rob.currentState       = "IDLE";
    if (rob.plannedRoute != null) rob.plannedRoute.clear();
    rob.clearRoute();
    rob.buildLocalOrderList();
    traceln("COMPARE Robot" + i + " reset at node" + (nodeIdx+1)
        + " | list=" + rob.localOrderList.size());
}

// Trigger statecharts
for (int i = 0; i < numRobots; i++) {
    Robot rob = getRobotByIndex(i);
    if (rob != null) rob.onChange();
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1790000100004</Id>
					<Name><![CDATA[writeFinalComparison]]></Name>
					<X>880</X><Y>870</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (summaryLogWriter == null) return;
// Blank separator line + comparison block
try {
    summaryLogWriter.println("");
    summaryLogWriter.println("# COMPARISON SUMMARY");
    summaryLogWriter.printf("# %-6s  %10s%n", "Mode", "Makespan(s)");
    for (int p = 0; p < 3; p++) {
        summaryLogWriter.printf("# %-6s  %10.2f%n", getModeName(p), phaseMakespan[p]);
    }
    double best = Math.min(phaseMakespan[0], Math.min(phaseMakespan[1], phaseMakespan[2]));
    for (int p = 0; p < 3; p++) {
        double saving = (phaseMakespan[p] > 0 && best > 0)
            ? 100.0 * (phaseMakespan[p] - best) / phaseMakespan[p] : 0;
        summaryLogWriter.printf("# %-6s  vs best: +%.1f%%%n", getModeName(p), saving);
    }
    summaryLogWriter.flush();
} catch (Exception e) { traceln("Final comparison write error: " + e.getMessage()); }
// Final dashboard update
updateStatusDisplay();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1777899942946</Id>
					<Name><![CDATA[updateStatusDisplay]]></Name>
					<X>880</X><Y>740</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String modeLabel = (routingMode == 3)
    ? "COMPARE | Phase " + (comparisonPhase >= 0 ? comparisonPhase : 0)
      + " [" + getModeName(effectiveRoutingMode) + "]"
    : getModeName(effectiveRoutingMode);

statusText = "=== ROBOT STATUS | t=" + String.format("%.1f", time())
    + " | Mode: " + modeLabel + " ===\n\n";

for (int i = 0; i < numRobots; i++) {
    Robot rob = getRobotByIndex(i);
    if (rob == null) continue;
    String posNode = "-";
    if (rob.goalNode != null) {
        int posIdx = globalNodes.indexOf(rob.goalNode);
        posNode = posIdx >= 0 ? "node" + (posIdx + 1) : "?";
    }
    String order = "-";
    if (!rob.currentState.equals("IDLE") && !rob.currentState.equals("COMPLETE")) {
        order = "pickup=node" + (rob.currentPickupIdx + 1)
              + " -> dest=node" + (rob.currentDestIdx + 1);
    }
    statusText += "Robot" + i + "  [" + rob.currentState + "]\n"
        + "  Order:     " + order + "\n"
        + "  Position:  " + posNode + "\n"
        + "  Done:      " + rob.ordersCompleted + " orders\n"
        + "  Remaining: " + rob.localOrderList.size() + " in list\n\n";
}
statusText += "Remaining in global queue: " + orderList.size() + "\n";
statusText += "Phase deliveries: " + phaseDeliveryCount + "\n";

// ── Dashboard text ─────────────────────────────────────────────────
dashboardText = "╔═══════════════════════════════════╗\n"
    + "║   PERFORMANCE DASHBOARD           ║\n"
    + "╠═══════════════════════════════════╣\n";

if (routingMode == 3) {
    // Show results for completed phases, live for current phase
    String[] mNames = {"SSP", "EV ", "EA "};
    dashboardText += String.format("║ %-6s  %8s  %8s  %5s ║%n",
        "Mode", "Makespan", "AvgTask", "Done");
    for (int p = 0; p <= (comparisonPhase >= 0 ? comparisonPhase : 0); p++) {
        boolean current = (p == comparisonPhase);
        double mksp = current ? (time() - phaseStartSimTime) : phaseMakespan[p];
        double avg  = current
            ? (phaseDeliveryCount > 0 ? phaseTaskTimeSum / phaseDeliveryCount : 0)
            : phaseMakespan[p]; // use best available
        int    done = current ? phaseDeliveryCount : numOrders;
        dashboardText += String.format("║ %s%s  %7.1fs  %7.1fs  %3d/%d ║%n",
            mNames[p], current ? "*" : " ", mksp, avg, done, numOrders);
    }
    // If all phases done, show winner
    if (comparisonPhase == 2 && phaseMakespan[2] > 0) {
        double best = Math.min(phaseMakespan[0], Math.min(phaseMakespan[1], phaseMakespan[2]));
        String winner = (best == phaseMakespan[0]) ? "SSP" : (best == phaseMakespan[1]) ? "EV" : "EA";
        dashboardText += "╠═══════════════════════════════════╣\n";
        dashboardText += String.format("║ Winner: %-4s  (%.1fs)             ║%n", winner, best);
        for (int p = 0; p < 3; p++) {
            double saving = (phaseMakespan[p] > best)
                ? 100.0 * (phaseMakespan[p] - best) / phaseMakespan[p] : 0;
            dashboardText += String.format("║  %s vs best: +%.1f%%              ║%n",
                mNames[p], saving);
        }
    }
} else {
    // Single-mode KPI panel
    double elapsed = time() - phaseStartSimTime;
    double avgT = (phaseDeliveryCount > 0) ? phaseTaskTimeSum / phaseDeliveryCount : 0;
    dashboardText += String.format("║ Mode:        %-21s║%n", getModeName(effectiveRoutingMode));
    dashboardText += String.format("║ Elapsed:     %7.1f s              ║%n", elapsed);
    dashboardText += String.format("║ Deliveries:  %3d / %-3d              ║%n", phaseDeliveryCount, numOrders);
    dashboardText += String.format("║ Avg task:    %7.1f s              ║%n", avgT);
    dashboardText += String.format("║ Min task:    %7.1f s              ║%n",
        phaseMinTaskTime == Double.MAX_VALUE ? 0 : phaseMinTaskTime);
    dashboardText += String.format("║ Max task:    %7.1f s              ║%n", phaseMaxTaskTime);
    dashboardText += "╠═══════════════════════════════════╣\n";
    dashboardText += String.format("║ %-7s  Tasks  Avg time          ║%n", "Robot");
    for (int i = 0; i < numRobots; i++) {
        double robAvg = (phaseRobotTaskCount[i] > 0)
            ? phaseRobotTotalTime[i] / phaseRobotTaskCount[i] : 0;
        dashboardText += String.format("║  R%-1d       %3d    %7.1f s        ║%n",
            i, phaseRobotTaskCount[i], robAvg);
    }
}
dashboardText += "╚═══════════════════════════════════╝";]]></Body>
				</Function>
