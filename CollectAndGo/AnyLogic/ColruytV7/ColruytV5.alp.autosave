globalNodes.add(new NodeLoc(node58.getX(), node58.getY()));
globalNodes.add(new NodeLoc(node59.getX(), node59.getY()));
globalNodes.add(new NodeLoc(node60.getX(), node60.getY()));
globalNodes.add(new NodeLoc(node61.getX(), node61.getY()));
globalNodes.add(new NodeLoc(node62.getX(), node62.getY()));
globalNodes.add(new NodeLoc(node63.getX(), node63.getY()));
globalNodes.add(new NodeLoc(node64.getX(), node64.getY()));
globalNodes.add(new NodeLoc(node65.getX(), node65.getY()));
globalNodes.add(new NodeLoc(node66.getX(), node66.getY()));
globalNodes.add(new NodeLoc(node67.getX(), node67.getY()));
globalNodes.add(new NodeLoc(node68.getX(), node68.getY()));
globalNodes.add(new NodeLoc(node69.getX(), node69.getY()));
globalNodes.add(new NodeLoc(node70.getX(), node70.getY()));
globalNodes.add(new NodeLoc(node71.getX(), node71.getY()));
globalNodes.add(new NodeLoc(node72.getX(), node72.getY()));
globalNodes.add(new NodeLoc(node73.getX(), node73.getY()));
globalNodes.add(new NodeLoc(node74.getX(), node74.getY()));
globalNodes.add(new NodeLoc(node75.getX(), node75.getY()));


// ===== SET CROWDEDNESS =====
// Ring road – center area (busy)
globalNodes.get(6).crowdedness = 8;   // node7
globalNodes.get(7).crowdedness = 7;   // node8
globalNodes.get(8).crowdedness = 7;   // node9
globalNodes.get(9).crowdedness = 5;   // node10
globalNodes.get(10).crowdedness = 5;  // node11
// Cross road (moderate)
globalNodes.get(0).crowdedness = 4;   // node1
globalNodes.get(1).crowdedness = 4;   // node2
globalNodes.get(2).crowdedness = 6;   // node3
globalNodes.get(3).crowdedness = 6;   // node4
globalNodes.get(4).crowdedness = 5;   // node5
globalNodes.get(5).crowdedness = 5;   // node6
globalNodes.get(12).crowdedness = 5;  // node13
// Outer ring (quiet)
globalNodes.get(29).crowdedness = 2;  // node30
globalNodes.get(38).crowdedness = 1;  // node39
globalNodes.get(44).crowdedness = 1;  // node45
 
// ===== BUILD ADJACENCY GRAPH =====
com.anylogic.engine.markup.Wall[] allWalls =
    {wall1, wall2, wall3, wall4, wall5, wall6, wall7, wall8, wall9, wall10, wall11, wall12};
double wallThreshold = 3.0;
double maxEdgeDist = 100.0;
 
for (int i = 0; i < globalNodes.size(); i++) {
  for (int j = i+1; j < globalNodes.size(); j++){
    NodeLoc a = globalNodes.get(i);
    NodeLoc b = globalNodes.get(j);
    double dist = Math.sqrt(
        Math.pow(a.x-b.x,2)+Math.pow(a.y-b.y,2));
    if (dist > maxEdgeDist) continue;
 
    boolean blocked = false;
    int numSamples = Math.max(5,(int)(dist/5.0));
    for (int s=1; s<numSamples && !blocked; s++){
      double t = (double) s / numSamples;
      double sx = a.x + t*(b.x - a.x);
      double sy = a.y + t*(b.y - a.y);
      for (var w : allWalls) {
        Point pWall = new Point();
        w.getNearestPoint(sx, sy, pWall);
        double dw = Math.sqrt(
            Math.pow(sx-pWall.getX(),2)
          + Math.pow(sy-pWall.getY(),2));
        if (dw < wallThreshold) {
          blocked = true; break;
        }
      }
    }
    if (!blocked) {
      a.edges.add(new NodeLoc.Edge(b, dist));
      b.edges.add(new NodeLoc.Edge(a, dist));
    }
  }
}
traceln("Adjacency graph: "
      + globalNodes.size() + " nodes");
 
// ===== SPAWN INITIAL PEDESTRIANS =====
int initialCount =
    (int)(pedestrianArrivalRate() * 20);
for (int i = 0; i < initialCount; i++) {
    add_pedestrian();
}

// Set node indices for CSV logging
for (int i = 0; i < globalNodes.size(); i++) {
    globalNodes.get(i).nodeIndex = i;
}


currentStart = globalNodes.get(0);

// randomize the package over the nodes 



// Generate order list and open CSV
simulationStartTime = (int) time();
// COMPARE mode initialisation
comparisonPhase      = (routingMode == 3) ? 0  : -1;
effectiveRoutingMode = (routingMode == 3) ? 0  : routingMode;
phaseStartSimTime    = simulationStartTime;
initEnvironment();
simulationReady = true;
openCsv();
traceln("=== ON MODEL START | simTime=" + time() + " ===");
for (int i = 0; i < numRobots; i++) {
    Robot rob = getRobotByIndex(i);
    if (rob != null) {
        rob.onChange();
        traceln("Robot" + rob.robotId + " onChange() called | simTime=" + time());
    }
}
spawnDelayEvent.restart();
]]></StartupCode>
			<DestroyCode><![CDATA[// Stop spawning
eventSpawnPedestrian.reset();
source.set_arrivalType(source.MANUAL);

// Halt all active pedestrians
for (Pedestrian p : pedestrians) {
    p.stop();
}

// Halt all robots
for (int i = 0; i < 4; i++) {
    Robot r = getRobotByIndex(i);
    if (r != null) r.stop();
}

// Write final summary and close CSV (early-stop fallback)
if (simulationReady) writeMakespanRow(time() - phaseStartSimTime);
closeCsv();]]></DestroyCode>
