			<StatechartElements>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1779640062186</Id>
					<Name><![CDATA[stInit]]></Name>
					<X>300</X><Y>100</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="50">
						<EntryAction><![CDATA[parStartNode = null;
parDestinationNode = null;
traceln("Robot" + robotId + " stInit ENTRY FIRED | simTime=" + time()
    + " | localOrderList.size=" + localOrderList.size());
if (localOrderList.size() > 0) onChange();]]></EntryAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1776689338483</Id>
					<Name><![CDATA[stDeliver]]></Name>
					<X>300</X><Y>300</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="50">
						<EntryAction><![CDATA[traceln("Robot" + robotId + " stDeliver entered | plannedRoute size="
    + (plannedRoute != null ? plannedRoute.size() : "NULL"));

if (plannedRoute != null && !plannedRoute.isEmpty()) {
	currentState= "DELIVERING";
    NodeLoc nextNode = plannedRoute.remove(0);
    goalNode = nextNode;
    setSpeed(10.0 / (1.0 + goalNode.crowdedness * 0.3));
    moveTo(nextNode.x, nextNode.y);
    traceln("Robot" + robotId + " moving to node" + (main.globalNodes.indexOf(nextNode)+1));
}]]></EntryAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1778249431667</Id>
					<Name><![CDATA[stReturn]]></Name>
					<X>460</X><Y>300</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="50">
						<EntryAction><![CDATA[timeReachedDest = time();
int phaseIdxR = (main.comparisonPhase >= 0) ? main.comparisonPhase : 0;
main.writeEventLog(phaseIdxR, main.effectiveRoutingMode, time(), robotId, "ARRIVED_AT_DEST",
    "node" + (currentPickupIdx+1), "node" + (currentDestIdx+1), myOrderId,
    "delivLegTime=" + String.format("%.1f", timeReachedDest - timeArrivedAtPickup) + "s");
traceln("Robot" + robotId + " entered stReturn.");

NodeLoc myPos = findClosestNode(getX(), getY());
plannedRoute = calculatePath(myPos, parStartNode, parDeliveryMode);
routeHopsReturn = (plannedRoute != null) ? plannedRoute.size() : 0;
main.writeEventLog(phaseIdxR, main.effectiveRoutingMode, time(), robotId, "DEPART_RETURN",
    "node" + (currentPickupIdx+1), "node" + (currentDestIdx+1), myOrderId,
    "hops=" + routeHopsReturn);

java.awt.Color[] retColors = {
    java.awt.Color.RED, java.awt.Color.ORANGE,
    new java.awt.Color(0,100,0), new java.awt.Color(0,100,100)
};
java.awt.Color rc = (robotId < retColors.length) ? retColors[robotId] : java.awt.Color.GRAY;
drawRoute(plannedRoute, myPos, rc);

if (plannedRoute != null && !plannedRoute.isEmpty()) {
	currentState = "GOING TO STORE";
    NodeLoc nextNode = plannedRoute.remove(0);
    goalNode = nextNode;
    setSpeed(10.0 / (1.0 + goalNode.crowdedness * 0.3));
    moveTo(nextNode.x, nextNode.y);
} else {
    returnComplete = true;
    onChange();
}]]></EntryAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1777592317820</Id>
					<Name><![CDATA[stComplete]]></Name>
					<X>460</X><Y>180</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="50">
						<EntryAction><![CDATA[clearRoute();

double toPickupTime  = timeArrivedAtPickup - timeOrderStart;
double delivLegTime  = timeReachedDest - timeArrivedAtPickup;
double returnTime    = time() - timeReachedDest;
double totalTime     = time() - timeOrderStart;

traceln("Robot" + robotId + " COMPLETE! | toPickup=" + String.format("%.1f", toPickupTime)
    + "s | delivLeg=" + String.format("%.1f", delivLegTime)
    + "s | return=" + String.format("%.1f", returnTime)
    + "s | total=" + String.format("%.1f", totalTime) + "s");

main.writeCsvRow(
    robotId, myOrderId, main.effectiveRoutingMode,
    "node" + (currentPickupIdx+1), "node" + (currentDestIdx+1),
    timeOrderStart, toPickupTime, delivLegTime, returnTime, totalTime,
    expectedOutTime, expectedInTime,
    routeHopsToStore, routeHopsToDestination, routeHopsReturn);

ordersCompleted++;
main.totalDeliveries++;  // increment on Main instead
myPackage = null;
parDestinationNode = null;
parStartNode = null;
// stComplete entry action — release claim
String taskKey = currentPickupIdx + "_" + currentDestIdx;
main.claimedOrders.remove(taskKey);

// Rebuild from current position
buildLocalOrderList();
traceln("Robot" + robotId + " rebuilt local list | remaining=" + localOrderList.size());

if (localOrderList.isEmpty()) {
	currentState = "COMPLETE";
    traceln("Robot" + robotId + " no more orders. Becoming idle.");
	main.totalDeliveries++;
	traceln("Robot" + robotId + " COMPLETE! Total deliveries so far: " + main.totalDeliveries);
    if (time() > 0 && ordersCompleted > 0) main.checkAllDone();
} else {
    // Trigger stInit → stGoToPickup condition re-evaluation
    onChange();
}]]></EntryAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1777894091143</Id>
					<Name><![CDATA[stGoToPickup]]></Name>
					<X>300</X><Y>190</Y>
					<Label><X>10</X><Y>20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="120" Height="50">
						<EntryAction><![CDATA[NodeLoc myPos = findClosestNode(getX(), getY());

traceln("Robot" + robotId + " stGoToPickup ENTRY FIRED | simTime=" + time()
    + " | myPos=" + (myPos != null ? "node" + (main.globalNodes.indexOf(myPos)+1) : "NULL")
    + " | parStartNode=" + (parStartNode != null ? "node" + (main.globalNodes.indexOf(parStartNode)+1) : "NULL")
    + " | sameNode=" + (myPos == parStartNode)
    + " | globalNodes.size=" + main.globalNodes.size());


plannedRoute = calculatePath(myPos, parStartNode, parDeliveryMode);
routeHopsToStore = (plannedRoute != null) ? plannedRoute.size() : 0;

traceln("Robot" + robotId + " plannedRoute size=" + (plannedRoute != null ? plannedRoute.size() : "NULL"));

int phaseIdx = (main.comparisonPhase >= 0) ? main.comparisonPhase : 0;
main.writeEventLog(phaseIdx, main.effectiveRoutingMode, time(), robotId, "DEPART_TO_PICKUP",
    "node" + (currentPickupIdx+1), "node" + (currentDestIdx+1), myOrderId,
    "hops=" + routeHopsToStore);

if (plannedRoute != null && !plannedRoute.isEmpty()) {
	currentState= "GOING TO STORE";
    java.awt.Color[] rColors = {
        java.awt.Color.BLUE,
        java.awt.Color.MAGENTA,
        new java.awt.Color(0, 180, 0),
        java.awt.Color.CYAN
    };
    java.awt.Color routeColor = (robotId < rColors.length) ? rColors[robotId] : java.awt.Color.WHITE;
    drawRoute(plannedRoute, myPos, routeColor);

    NodeLoc nextNode = plannedRoute.remove(0);
    goalNode = nextNode;
    setSpeed(10.0 / (1.0 + goalNode.crowdedness * 0.3));
    moveTo(nextNode.x, nextNode.y);
} else {
    traceln("WARNING: Robot" + robotId + " empty route in stGoToPickup — already at store or graph issue");
    goalNode = parStartNode;
}]]></EntryAction>
