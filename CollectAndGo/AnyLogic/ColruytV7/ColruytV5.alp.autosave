					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ped]]></Name>
						<Type><![CDATA[Pedestrian]]></Type>
					</Parameter>
					<Body><![CDATA[remove_pedestrian(ped);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1780400000001</Id>
					<Name><![CDATA[initEnvironment]]></Name>
					<X>1040</X><Y>680</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[orderList.clear();
claimedOrders.clear();

// COMPARE mode phases 1 & 2: restore saved orders, skip re-generation
if (routingMode == 3 && comparisonPhase > 0) {
    for (int[] t : savedOrderList) orderList.add(new int[]{t[0], t[1], t[2]});
    traceln("=== COMPARE Phase " + comparisonPhase + " (" + getModeName(effectiveRoutingMode)
        + "): restored " + orderList.size() + " orders (stores already placed) ===");
    int[] startNodes = {0, 10, 40, 60};
    for (int i = 0; i < numRobots; i++) {
        Robot rob = getRobotByIndex(i);
        if (rob != null) {
            rob.robotId = i;
            int nodeIdx = startNodes[Math.min(i, startNodes.length - 1)];
            NodeLoc startLoc = globalNodes.get(nodeIdx);
            rob.setXY(startLoc.x, startLoc.y);
            rob.buildLocalOrderList();
        }
    }
    return;
}

for (int i = Store.size() - 1; i >= 0; i--) {
    remove_Store(Store.get(i));
}

traceln("=== initEnvironment START | simTime=" + time() + " ===");

java.util.Random rng = new java.util.Random(randomSeed);
java.util.List<Integer> validIdx = new java.util.ArrayList<>();
for (int i = 1; i < globalNodes.size(); i++) validIdx.add(i);

int numStores = 4;
java.util.List<Integer> storeNodeIndices = new java.util.ArrayList<>();
java.util.List<Integer> shuffled = new java.util.ArrayList<>(validIdx);
java.util.Collections.shuffle(shuffled, rng);
for (int s = 0; s < numStores && s < shuffled.size(); s++) {
    int nodeIdx = shuffled.get(s);
    NodeLoc loc = globalNodes.get(nodeIdx);
    Package store = add_Store();
    store.setXYZ(loc.x, loc.y, 0);
    store.orderIndex = nodeIdx;
    storeNodeIndices.add(nodeIdx);
}

for (int i = 0; i < numOrders; i++) {
    int pickupIdx = storeNodeIndices.get(rng.nextInt(storeNodeIndices.size()));
    int destIdx = pickupIdx;
    int attempts = 0;
    do {
        destIdx = validIdx.get(rng.nextInt(validIdx.size()));
        NodeLoc p = globalNodes.get(pickupIdx);
        NodeLoc d = globalNodes.get(destIdx);
        double dist = Math.sqrt(Math.pow(p.x-d.x,2)+Math.pow(p.y-d.y,2));
        if (destIdx != pickupIdx && dist >= 50) break;
        attempts++;
    } while (attempts < 100);
    int[] task = {pickupIdx, destIdx, i};
    orderList.add(task);
}

traceln("=== STORES PLACED (seed=" + randomSeed + "): " + Store.size() + " ===");
for (int i = 0; i < Store.size(); i++) {
    Package s = (Package) Store.get(i);
    traceln("  store[" + i + "] @ node" + (s.orderIndex + 1));
}

traceln("=== ORDERS CREATED: " + orderList.size() + " ===");
for (int i = 0; i < orderList.size(); i++) {
    int[] t = orderList.get(i);
    traceln("  order[" + i + "]: pickup=node" + (t[0]+1) + " -> dest=node" + (t[1]+1));
}

// Save orders for COMPARE mode replay (phases 1 & 2)
if (routingMode == 3) {
    savedOrderList.clear();
    for (int[] t : orderList) savedOrderList.add(new int[]{t[0], t[1], t[2]});
    traceln("=== COMPARE: saved " + savedOrderList.size() + " orders for replay ===");
}

// Place robots and build their order lists
int[] startNodes = {0, 10, 40, 60};
for (int i = 0; i < numRobots; i++) {
    Robot rob = getRobotByIndex(i);
    if (rob != null) {
        rob.robotId = i;
        int nodeIdx = startNodes[Math.min(i, startNodes.length - 1)];
        NodeLoc startLoc = globalNodes.get(nodeIdx);
        rob.setXY(startLoc.x, startLoc.y);
        rob.buildLocalOrderList();
        traceln("Robot" + i + " placed at node" + (nodeIdx+1)
            + " | listSize=" + rob.localOrderList.size());
    }
}

traceln("=== initEnvironment END | simTime=" + time() + " ===");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Robot]]></ReturnType>
					<Id>1780400000008</Id>
					<Name><![CDATA[getRobotByIndex]]></Name>
					<X>1040</X><Y>710</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idx]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (idx == 0) return robot;
if (idx == 1) return robot2;
if (idx == 2) return robot3;
if (idx == 3) return robot4;
return null;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1780400000002</Id>
					<Name><![CDATA[assignNextTask]]></Name>
					<X>1040</X><Y>740</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[r]]></Name>
						<Type><![CDATA[Robot]]></Type>
					</Parameter>
					<Body><![CDATA[if (taskQueue.isEmpty()) {
    traceln("Robot" + r.robotId + " finished all tasks. Becoming idle.");
    r.parDestinationNode = null;
    checkAllDone();
    return;
}

int[] selectedTask = null;

if (effectiveRoutingMode == 2) {
    // EA: pick task with min expected completion time + conflict penalty
    double bestScore = Double.MAX_VALUE;
    NodeLoc robPos = r.findClosestNode(r.getX(), r.getY());
    for (int[] task : taskQueue) {
        NodeLoc pickup = globalNodes.get(task[0]);
        NodeLoc dest   = globalNodes.get(task[1]);
        double t = r.calculateExpectedTime(robPos, pickup, 1)
                 + r.calculateExpectedTime(pickup, dest, 1)
                 + r.calculateExpectedTime(dest, globalNodes.get(0), 1);
        // Conflict penalty: if another active robot targets same destination area
        double penalty = 0;
        for (int i = 0; i < numRobots; i++) {
            Robot other = getRobotByIndex(i);
            if (other == null || other == r) continue;
            if (other.parDestinationNode != null) {
                double overlap = Math.sqrt(
                    Math.pow(other.parDestinationNode.x - dest.x, 2) +
                    Math.pow(other.parDestinationNode.y - dest.y, 2));
                if (overlap < 40) penalty += 30.0;
            }
        }
        if (t + penalty < bestScore) {
            bestScore = t + penalty;
            selectedTask = task;
        }
    }
} else {
    // SSP / EV: greedy nearest pickup
    double nearestDist = Double.MAX_VALUE;
    for (int[] task : taskQueue) {
        NodeLoc pickup = globalNodes.get(task[0]);
        double d = Math.sqrt(Math.pow(r.getX()-pickup.x,2)+Math.pow(r.getY()-pickup.y,2));
        if (d < nearestDist) { nearestDist = d; selectedTask = task; }
    }
}

if (selectedTask == null) selectedTask = taskQueue.get(0);
taskQueue.remove(selectedTask);

r.parStartNode       = globalNodes.get(selectedTask[0]);
r.parDestinationNode = globalNodes.get(selectedTask[1]);
r.currentPickupIdx   = selectedTask[0];
r.currentDestIdx     = selectedTask[1];

// Find and assign the matching package by pickup node index
r.myPackage = null;
for (int i = 0; i < Store.size(); i++) {
    Package pkg = (Package) Store.get(i);
    if (pkg.orderIndex == selectedTask[0]) {
        r.myPackage = pkg;
        break;
    }
}
if (r.myPackage == null) {
    traceln("WARNING: no package found for orderIndex=" + selectedTask[2] + " (pickupIdx=" + selectedTask[0] + ")");

}


robotOrders[r.robotId]++;
traceln("=== Task -> Robot" + r.robotId + ": pickup=node" + (selectedTask[0]+1)
    + " dest=node" + (selectedTask[1]+1) + " (queue left: " + taskQueue.size() + ") ===");
r.onChange();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1780400000005</Id>
					<Name><![CDATA[checkAllDone]]></Name>
					<X>1040</X><Y>770</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// checkAllDone on Main — absolute first line
if (time() == 0) return;
if (!simulationReady) return;
if (orderList.size() > 0) return;

for (int i = 0; i < numRobots; i++) {
    Robot rob = getRobotByIndex(i);
    if (rob == null) continue;
    if (rob.localOrderList.size() > 0) return;
    if (rob.parDestinationNode != null) return;
}

double makespan = time() - phaseStartSimTime;
int phaseIdx = (comparisonPhase >= 0) ? comparisonPhase : 0;
traceln("=== " + getModeName(effectiveRoutingMode) + " COMPLETE | phase=" + phaseIdx
    + " makespan=" + String.format("%.2f", makespan) + "s | deliveries=" + phaseDeliveryCount + " ===");

if (routingMode == 3) {
    phaseMakespan[phaseIdx] = makespan;
    writeMakespanRow(makespan);
    if (comparisonPhase < 2) {
        resetForNextPhase();
        return;
    }
    // All 3 phases done
    writeFinalComparison();
    closeCsv();
} else {
    writeMakespanRow(makespan);
    closeCsv();
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1780400000003</Id>
					<Name><![CDATA[openCsv]]></Name>
					<X>880</X><Y>620</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
    java.time.LocalDateTime now = java.time.LocalDateTime.now();
    currentRunId = now.format(java.time.format.DateTimeFormatter.ofPattern("yyyyMMdd_HHmmss"));

    // ── File 1: per-task detail log ──────────────────────────────────────
    String detailFile = "detail_" + currentRunId + ".csv";
    csvWriter = new java.io.PrintWriter(new java.io.FileWriter(detailFile, false));
    csvWriter.println("runId,phase,effectiveMode,modeName,"
        + "robotId,taskSeq,pickupNode,destNode,"
        + "taskStartSim,toPickupSec,deliveryLegSec,returnSec,totalSec,"
        + "expOutSec,expInSec,hopsToStore,hopsToDest,hopsReturn,"
        + "crowdednessLevel,numRobots,numOrders,randomSeed");
    csvWriter.flush();

    // ── File 2: timestamped event log ────────────────────────────────────
    String eventFile = "events_" + currentRunId + ".csv";
    eventLogWriter = new java.io.PrintWriter(new java.io.FileWriter(eventFile, false));
    eventLogWriter.println("runId,phase,effectiveMode,modeName,"
        + "simTime,robotId,eventType,pickupNode,destNode,taskSeq,detail");
    eventLogWriter.flush();

    // ── File 3: per-phase summary log ────────────────────────────────────
    String summaryFile = "summary_" + currentRunId + ".csv";
    summaryLogWriter = new java.io.PrintWriter(new java.io.FileWriter(summaryFile, false));
    summaryLogWriter.println("runId,phase,effectiveMode,modeName,"
        + "numRobots,numOrders,crowdednessLevel,randomSeed,"
        + "makespan,totalDeliveries,"
        + "avgTaskSec,minTaskSec,maxTaskSec,"
        + "avgToPickupSec,avgDeliveryLegSec,avgReturnSec,"
        + "robot0Tasks,robot1Tasks,robot2Tasks,robot3Tasks,"
        + "robot0TotalSec,robot1TotalSec,robot2TotalSec,robot3TotalSec");
    summaryLogWriter.flush();

    traceln("CSV files opened: " + detailFile + " | " + eventFile + " | " + summaryFile);
} catch (Exception e) {
    traceln("CSV open error: " + e.getMessage());
    csvWriter = null; eventLogWriter = null; summaryLogWriter = null;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1780400000004</Id>
					<Name><![CDATA[writeCsvRow]]></Name>
					<X>880</X><Y>650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[robotId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[taskId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[mode]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[pickupNode]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[destNode]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[taskStartTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[toPickupSec]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[deliveryLegSec]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[returnSec]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[totalTime]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[expOut]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[expIn]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[hopsToStore]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[hopsToDest]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[hopsReturn]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[int phaseIdx = (comparisonPhase >= 0) ? comparisonPhase : 0;
String modeName = getModeName(mode);

// ── Detail row ───────────────────────────────────────────────────────
if (csvWriter != null) {
    try {
        csvWriter.printf("%s,%d,%d,%s,%d,%d,%s,%s,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%d,%d,%d,%d,%d,%d,%d%n",
            currentRunId, phaseIdx, mode, modeName,
            robotId, taskId, pickupNode, destNode,
            taskStartTime, toPickupSec, deliveryLegSec, returnSec, totalTime,
            expOut, expIn, hopsToStore, hopsToDest, hopsReturn,
            crowdednessLevel, numRobots, numOrders, randomSeed);
        csvWriter.flush();
    } catch (Exception e) { traceln("Detail CSV write error: " + e.getMessage()); }
}

// ── Event row: TASK_COMPLETE ─────────────────────────────────────────
writeEventLog(phaseIdx, mode, time(), robotId, "TASK_COMPLETE",
    pickupNode, destNode, taskId,
    String.format("total=%.1fs toPickup=%.1fs delivery=%.1fs return=%.1fs",
        totalTime, toPickupSec, deliveryLegSec, returnSec));

// ── Per-phase accumulators ───────────────────────────────────────────
phaseDeliveryCount++;
phaseTaskTimeSum    += totalTime;
phaseOutTimeSum     += toPickupSec;
phaseInTimeSum      += deliveryLegSec;
phaseReturnTimeSum  += returnSec;
if (totalTime < phaseMinTaskTime) phaseMinTaskTime = totalTime;
if (totalTime > phaseMaxTaskTime) phaseMaxTaskTime = totalTime;
if (robotId >= 0 && robotId < 4) {
    phaseRobotTaskCount[robotId]++;
    phaseRobotTotalTime[robotId] += totalTime;
}
totalDeliveries++;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1780400000006</Id>
					<Name><![CDATA[writeMakespanRow]]></Name>
					<X>880</X><Y>680</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[makespan]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[int phaseIdx  = (comparisonPhase >= 0) ? comparisonPhase : 0;
String mName  = getModeName(effectiveRoutingMode);
int    n      = phaseDeliveryCount;
double avgT   = (n > 0) ? phaseTaskTimeSum / n : 0;
double minT   = (phaseMinTaskTime == Double.MAX_VALUE) ? 0 : phaseMinTaskTime;
double avgPickup  = (n > 0) ? phaseOutTimeSum    / n : 0;
double avgDelivLeg = (n > 0) ? phaseInTimeSum    / n : 0;
double avgReturn   = (n > 0) ? phaseReturnTimeSum / n : 0;

if (summaryLogWriter != null) {
    try {
        summaryLogWriter.printf(
            "%s,%d,%d,%s,%d,%d,%d,%d,"
            + "%.2f,%d,"
            + "%.2f,%.2f,%.2f,"
            + "%.2f,%.2f,%.2f,"
            + "%d,%d,%d,%d,"
            + "%.2f,%.2f,%.2f,%.2f%n",
            currentRunId, phaseIdx, effectiveRoutingMode, mName,
            numRobots, numOrders, crowdednessLevel, randomSeed,
            makespan, n,
            avgT, minT, phaseMaxTaskTime,
            avgPickup, avgDelivLeg, avgReturn,
            phaseRobotTaskCount[0], phaseRobotTaskCount[1],
            phaseRobotTaskCount[2], phaseRobotTaskCount[3],
            phaseRobotTotalTime[0], phaseRobotTotalTime[1],
            phaseRobotTotalTime[2], phaseRobotTotalTime[3]);
        summaryLogWriter.flush();
    } catch (Exception e) { traceln("Summary CSV write error: " + e.getMessage()); }
}
// Log phase-end event
writeEventLog(phaseIdx, effectiveRoutingMode, time(), -1, "PHASE_END",
    "-", "-", -1,
    String.format("makespan=%.2fs deliveries=%d avgTask=%.2fs", makespan, n, avgT));
updateStatusDisplay();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1780400000007</Id>
					<Name><![CDATA[closeCsv]]></Name>
					<X>880</X><Y>710</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (csvWriter != null)       { csvWriter.close();       csvWriter = null; }
if (eventLogWriter != null) { eventLogWriter.close();   eventLogWriter = null; }
if (summaryLogWriter != null){ summaryLogWriter.close(); summaryLogWriter = null; }
traceln("All CSV files closed.");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1790000100001</Id>
					<Name><![CDATA[getModeName]]></Name>
					<X>880</X><Y>780</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[mode]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (mode == 0) return "SSP";
if (mode == 1) return "EV";
if (mode == 2) return "EA";
return "SSP";]]></Body>
