				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1777592317820</Id>
					<Name><![CDATA[stComplete]]></Name>
					<X>450</X><Y>150</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="50">
						<EntryAction><![CDATA[clearRoute();

double actualOut  = timeReachedDest - timeOrderStart;
double actualIn   = time() - timeReachedDest;
double totalTime  = time() - timeOrderStart;

traceln("Robot" + robotId + " COMPLETE! | Out: " + String.format("%.1f", actualOut)
    + "s (Exp: " + String.format("%.1f", expectedOutTime) + "s)"
    + " | In: " + String.format("%.1f", actualIn)
    + "s (Exp: " + String.format("%.1f", expectedInTime) + "s)"
    + " | Total: " + String.format("%.1f", totalTime) + "s");
    
// remove package
main.remove_Store(myPackage);
myPackage = null;

// Log to CSV
main.writeCsvRow(
    robotId, myOrderId, main.routingMode,
    "node" + (currentPickupIdx+1), "node" + (currentDestIdx+1),
    timeOrderStart, timeReachedDest - timeOrderStart, actualIn, totalTime,
    expectedOutTime, expectedInTime);

ordersCompleted++;
parDestinationNode = null;

// Request next task (or go idle if queue empty)
main.assignNextTask(this);]]></EntryAction>
