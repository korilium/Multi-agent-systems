					<Action><![CDATA[// One-time kick-start: assign initial tasks to all active robots

simulationStartTime = time();
traceln("=== SIMULATION START: routingMode=" + routingMode + " numRobots=" + numRobots + " numOrders=" + numOrders + " ===");
for (int i = 0; i < numRobots; i++) {
    Robot r = getRobotByIndex(i);
    if (r != null) assignNextTask(r);
}
]]></Action>
