			<StatechartElements>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1775186276161</Id>
					<Name><![CDATA[stInit]]></Name>
					<X>300</X><Y>80</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="50">
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1779640062186</Id>
					<Name><![CDATA[stPickup]]></Name>
					<X>300</X><Y>150</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="50">
						<EntryAction><![CDATA[if (main.robotOrders[robotId] > myOrderId) {
    myOrderId = main.robotOrders[robotId];
    timeOrderStart = time();

    // Teleport to pickup node (parStartNode set by main.assignNextTask)
    if (parStartNode != null) setXY(parStartNode.x, parStartNode.y);
    goalNode = parStartNode;

    // Dijkstra mode: 0=shortest-path (SSP), 1=crowd-weighted (EV and EA both use this)
    int dijkstraMode = (main.routingMode == 0) ? 0 : 1;
    parDeliveryMode = dijkstraMode;

    if (parDestinationNode != null && parStartNode != null) {
        expectedOutTime = calculateExpectedTime(parStartNode, parDestinationNode, dijkstraMode);
        expectedInTime  = calculateExpectedTime(parDestinationNode, parStartNode, dijkstraMode);
        plannedRoute    = calculatePath(parStartNode, parDestinationNode, dijkstraMode);

        // Color per robotId
        java.awt.Color[] rColors = {java.awt.Color.BLUE, java.awt.Color.MAGENTA,
                                    new java.awt.Color(0,180,0), java.awt.Color.CYAN};
        java.awt.Color routeColor = (robotId < rColors.length) ? rColors[robotId] : java.awt.Color.WHITE;
        drawRoute(plannedRoute, parStartNode, routeColor);

        traceln("Robot" + robotId + " stPickup: pickup=node" + (currentPickupIdx+1)
            + " dest=node" + (currentDestIdx+1)
            + " routeLen=" + plannedRoute.size() + " dijkstraMode=" + dijkstraMode);
    }
} else {
    traceln("Robot" + robotId + " stPickup aborted: already at order " + myOrderId);
}

// Hide package after successful task assignment
if (myPackage != null) {
    myPackage.hide();
    traceln("Robot" + robotId + " picked up package, myPackage hidden");
} else {
    traceln("WARNING: Robot" + robotId + " myPackage is null at pickup");
}




traceln("Robot stPickup: myOrderId=" + myOrderId + " packages.size=" + main.Store.size());


]]></EntryAction>
